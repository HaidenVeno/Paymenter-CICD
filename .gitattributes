# Normalize to LF in the repo. These files run inside Linux containers / on the
# Linux self-hosted runner; a CRLF shebang or config line would break them.
* text=auto eol=lf

*.sh    text eol=lf
*.j2    text eol=lf
*.conf  text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
Dockerfile* text eol=lf

# Binaries (none yet, but keep git from mangling future assets)
*.png binary
*.jpg binary
*.pdf binary
